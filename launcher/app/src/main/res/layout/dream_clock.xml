<?xml version="1.0" encoding="utf-8"?>
<!-- Screensaver (ClockDream): clock and date that drift around a black screen over an ambient glow. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <View
        android:id="@+id/dreamAmbient"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/dreamContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true">

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="#E6FFFFFF"
                android:textSize="120sp"
                android:fontFamily="@string/font_extralight"
                android:letterSpacing="-0.04"
                android:includeFontPadding="false" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:format12Hour="a"
                android:format24Hour=""
                android:textColor="#99FFFFFF"
                android:textSize="22sp"
                android:fontFamily="@string/font_medium"
                android:letterSpacing="0.08"
                android:textAllCaps="true" />
        </LinearLayout>

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="4dp"
            android:format12Hour="@string/date_format"
            android:format24Hour="@string/date_format"
            android:textColor="#8CFFFFFF"
            android:textSize="18sp"
            android:fontFamily="@string/font_regular"
            android:letterSpacing="0.14"
            android:textAllCaps="true" />

        <!-- Golden accent divider -->
        <View
            android:layout_width="320dp"
            android:layout_height="2dp"
            android:layout_marginStart="6dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="14dp"
            android:background="#E5A93C" />

        <!-- Prayer Times Timeline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/lock_prayer_times"
            android:textColor="#E5A93C"
            android:textSize="17sp"
            android:fontFamily="@string/font_medium"
            android:letterSpacing="0.06" />

        <!-- Thought of the Day / Adkar -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="16dp"
            android:text="@string/thought_kicker"
            android:textColor="#E5A93C"
            android:textSize="11sp"
            android:fontFamily="@string/font_medium"
            android:letterSpacing="0.22"
            android:textAllCaps="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="4dp"
            android:text="@string/adkar_prayer"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:fontFamily="@string/font_regular" />

        <!-- Location caption -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="10dp"
            android:text="📍 Benguerir, Maroc · 24°C"
            android:textColor="#66FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@string/font_regular" />
    </LinearLayout>
</FrameLayout>
