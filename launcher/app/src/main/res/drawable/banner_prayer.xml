<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="320dp" android:height="180dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="315"
                android:startColor="#FF0F281A"
                android:endColor="#FF07160E" />
            <stroke
                android:width="1.5dp"
                android:color="#4022C55E" />
        </shape>
    </item>
    <item
        android:width="72dp"
        android:height="72dp"
        android:gravity="center">
        <vector
            android:width="72dp"
            android:height="72dp"
            android:viewportWidth="100"
            android:viewportHeight="100">
            <!-- Golden Crescent Moon -->
            <path
                android:fillColor="#FFFACC15"
                android:pathData="M60,20 C42,20 28,36 28,55 C28,73 42,86 58,86 C66,86 74,83 80,78 C62,76 50,64 50,49 C50,34 60,23 76,21 C71,20 65,20 60,20 Z" />
            <!-- Star -->
            <path
                android:fillColor="#FFFACC15"
                android:pathData="M76,33 L78,38 L83,38 L79,41 L81,46 L76,43 L72,46 L74,41 L70,38 L75,38 Z" />
        </vector>
    </item>
</layer-list>
